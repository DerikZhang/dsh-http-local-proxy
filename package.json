{
  "name": "dsh-local-http-proxy",
  "version": "1.0.0",
  "description": "Set one HTTP proxy for plugin and package installs, with a switch and an editable address in the DSH Web UI.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "proxy",
    "http-proxy",
    "pnpm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DerikZhang/dsh-local-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/DerikZhang/dsh-local-proxy/issues"
  },
  "homepage": "https://github.com/DerikZhang/dsh-local-proxy#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
